{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@ex-machina/opencode-anthropic-auth@next", "-opencode.browser"],
    "permissions": [
        { "action": "shell", "resource": "*rbw get *", "effect": "ask" },
        { "action": "shell", "resource": "*rbw code *", "effect": "ask" },
        { "action": "shell", "resource": "*rbw totp *", "effect": "ask" },
        { "action": "shell", "resource": "*rbw history *", "effect": "ask" },
        { "action": "shell", "resource": "*rbw add *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw generate *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw gen *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw edit *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw rm *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw remove *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw purge *", "effect": "deny" },
        { "action": "shell", "resource": "*rbw config *", "effect": "deny" },
        { "action": "shell", "resource": "bw *", "effect": "ask" }
    ],
    "provider": {
        "pangolin": {
            "name": "Pangolin AI gateway",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://ai.leidwein.com/v1",
                "apiKey": "none"
            },
            "models": {}
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "browser-control": {
            "type": "local",
            "command": ["browser-control-mcp"],
            "enabled": true
        }
    }
}
