{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@ex-machina/opencode-anthropic-auth@next", "-opencode.browser"],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "browser-control": {
            "type": "local",
            "command": ["browser-control-mcp"],
            "enabled": true
        }
    }
}
